{
  "expo": {
    "name": "Caneto",
    "slug": "caneto-native",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "caneto",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.evandromqs.caneto",
      "versionCode": 5,
      "adaptiveIcon": {
        "backgroundColor": "#0943F1",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "./plugins/withGithubReleaseSigning",
      "expo-sqlite",
      "expo-font",
      "expo-router",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Caneto usa sua localização para mostrar lojas próximas e marcar a fachada de um local."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O Caneto usa a câmera para ler códigos, fotografar produtos e a fachada de lojas.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Caneto acessa a galeria para escolher a foto da fachada."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "72a9ea42-3a0b-4fdc-850c-0f3ef374a695"
      }
    },
    "owner": "evandroti"
  }
}
